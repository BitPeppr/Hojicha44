/*
 * Hojicha44 shared devicetree — compiled by CI against zmkfirmware/zmk
 * v0.3.0 (board nice_nano_v2, see .github/workflows/build.yml).
 *
 * Covers both halves: 4x6 matrix (R3C4-C5 unpopulated), EC11 on A0/A1 with
 * push on D16, NFC pins as GPIO. Per-half differences (UART only — see
 * hojicha44_{left,right}.overlay) live in the half overlays. The board
 * file provides vbatt/VDDH sensing (chosen zmk,battery is set there, so
 * this file must not redefine it) and defaults uart0 off.
 *
 * Verify with: west build -b nice_nano_v2 -- -DSHIELD=hojicha44_left
 * (needs a zmk-config wrapper providing the shield + board files).
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
        /* zmk,battery = &vbatt comes from the nice_nano_v2 board file. */
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;
        /* row-gpios / col-gpios are half-specific only in net NAME;
         * the Arduino pins are identical, so they live here. */
        row-gpios
            = <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>    /* R0 = D4  */
            , <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>    /* R1 = D5  */
            , <&gpio1  0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>    /* R2 = D6  */
            , <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;   /* R3 = D7  */
        col-gpios
            = <&gpio1  4 GPIO_ACTIVE_HIGH>      /* C0 = D8  */
            , <&gpio1  6 GPIO_ACTIVE_HIGH>      /* C1 = D9  */
            , <&gpio0 17 GPIO_ACTIVE_HIGH>      /* C2 = D2  */
            , <&gpio0 20 GPIO_ACTIVE_HIGH>      /* C3 = D3  */
            , <&gpio1 11 GPIO_ACTIVE_HIGH>      /* C4 = D14 */
            , <&gpio1 13 GPIO_ACTIVE_HIGH>;     /* C5 = D15 */
    };

    default_transform: transform {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9)
        >;
    };

    enc_sw: buttons_enc_sw {
        compatible = "gpio-keys";
        /* EC11 push is a dedicated GPIO (D16 = P0.10), not matrixed.
         * Shape per the Zephyr gpio-keys binding: one child node per
         * button carrying `gpios` (+ optional `label`/`zephyr,code`) —
         * a parent-level `sw-gpios` property does not exist.
         * S1 closes to GND, so ACTIVE_LOW with pull-up.
         * ZMK-docs discrepancy note: ZMK keymaps consume *kscan* events,
         * not Zephyr input events (zmk.dev/docs/features/encoders says a
         * push is "typically" part of the keyboard matrix). This node only
         * corrects the pin description; the keymap path is the direct
         * kscan below, consumed by the sideband in hojicha44.keymap.
         * Binding source: docs.zephyrproject.org/latest/build/dts/api/
         * bindings/input/gpio-keys.html */
        enc_sw_btn: button_enc_sw {
            label = "ENC push";
            gpios = <&gpio0 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
            zephyr,code = <INPUT_KEY_MUTE>;
        };
    };

    enc_push_kscan: kscan_enc_push {
        /* ZMK-supported keymap path for the dedicated-GPIO push: direct
         * kscan over the gpio-key above (`input-keys` takes gpio-key
         * phandles; the single key emits row 0 / column 0 events).
         * Consumed by the sideband in hojicha44.keymap; the chosen kscan
         * stays kscan0, so the 46-cell matrix path is untouched.
         * Binding source: zmk.dev/docs/config/kscan (Direct GPIO driver)
         * + app/module/drivers/kscan/kscan_gpio_direct.c in zmkfirmware/zmk
         * (`input-keys`, events at row 0 / column index). */
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-keys = <&enc_sw_btn>;
    };

    left_encoder: encoder_left {
        /* Shared node: defined ONCE here, enabled per-half by each overlay's
           &left_encoder { status = "okay"; } and consumed by sensors below.
           The name is NOT a left-half leak — do NOT rename per half. */
        compatible = "alps,ec11";
        a-gpios = <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;  /* A0 */
        b-gpios = <&gpio0  2 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;  /* A1 */
        steps = <15>;             /* EC11E15244G1: 30 detents but 15 PULSES/rev;
                                   ZMK `steps` counts pulses per revolution —
                                   confirm CW/CCW event counts over one full
                                   revolution on first article */
        status = "disabled";      /* enabled per half-overlay */
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;
        triggers-per-rotation = <30>;
    };
};

/* P0.09 (D10) and P0.10 (D16/ENC push) are NFC pins: take them as GPIO.
 * UICR is sticky — full chip erase required to apply or clear. */
&uicr {
    nfct-pins-as-gpios;
};
