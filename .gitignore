# dependencies
node_modules/

# macOS
.DS_Store

# reproducible outputs (regenerate via README; sources are the truth)
layout/generated/
*.log

# KiCad working-tree noise (release reports go to generated/release/)
*.kicad_prl
*.rpt
*-erc.rpt
*-drc.rpt

# versioned release evidence stays tracked (roadmap Phase 7/12)
/generated/
!/generated/release/
!generated/release/**
!pcb/- FINAL/**
pcb/- FINAL/.DS_Store

# regenerable render exports (kicad-cli sch export ...)
pcb/kicad/export/

# KiCad lock files + local scratch backups (never versioned)
*.lck
.backup/

# generated fit-print / release PDFs (kicad-cli; regenerate on demand)
out/
