# dependencies
node_modules/

# agent-harness scratch: run logs, probe scripts, and gen_pcb's pre-regen
# board archive (pcb/kicad/hand-copper.txt documents the convention) —
# untracked by design; the archived snapshots are cited from notes.md
opencode/

# macOS
.DS_Store

# reproducible outputs (regenerate via README; sources are the truth)
# Two tracked exceptions: they are gate INPUT — board.dxf (the outline,
# fed to build_placements) + points.yaml (the usb anchors check_board +
# plate/gen_plate --check referee) are read on CI, where nothing
# regenerates layout outputs. Keep the verified geometry committed so
# CI checks the same numbers the boards were cut from; a regen that
# moves either dirties the tree visibly and must ride the next commit.
layout/generated/**
!layout/generated/v2/
!layout/generated/v2/points/
!layout/generated/v2/points/points.yaml
!layout/generated/v2/outlines/
!layout/generated/v2/outlines/board.dxf
*.log

# KiCad working-tree noise (release reports go to generated/release/)
*.kicad_prl
*.rpt
*-erc.rpt
*-drc.rpt

# versioned release evidence stays tracked (roadmap Phase 7/12).
# Ignore generated/* children, not generated/ itself: Git cannot
# re-include a path whose parent directory is excluded, so /generated/
# would also swallow the !release rules (and force -f for every release).
/generated/*
!/generated/release/
!generated/release/**
# print-order manifest (audit-2 F-12): the hashes the shops are sent
!/generated/print/
!generated/print/**

# regenerable render exports (kicad-cli sch export ...)
pcb/kicad/export/

# KiCad lock files + local scratch backups (never versioned)
*.lck
.backup/

# generated fit-print / release PDFs (kicad-cli; regenerate on demand)
out/
case/.venv/
case/out/

# renders: the regenerable mesh/asset tree is a dev artifact; scripts +
# final PNGs under generated/renders/v0.5.0/ ARE tracked (see renders/README)
!/generated/renders/
!generated/renders/**
generated/renders/assets/
