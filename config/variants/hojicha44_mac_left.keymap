/* Hojicha44 keymap — mac_left variant.
 * GENERATED by config/gen_keymap.py from spec/layout.yaml — DO NOT EDIT.
 *   mod order : Ctrl Alt GUI Shift (macOS: Cmd on the middle)
 *   space     : left thumb (the other carries Enter)
 * Regenerate: python3 config/gen_keymap.py            (all variants)
 * Switch   : python3 config/gen_keymap.py --use mac_left
 * Design   : spec/keymap.md (the narrative for every table below).
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    /* Home-row mods, ZMK's documented "timeless" recipe: balanced flavor,
     * require-prior-idle (fast rolls resolve to taps), a long tapping term
     * (the POSITIONAL triggers decide, not the timer) and positional
     * hold-trigger-key-positions listing the OTHER hand's keys, with
     * hold-trigger-on-release so same-hand modifier combos still work.
     * One behavior per hand so the trigger lists can differ. */
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45>;
            hold-trigger-on-release;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39>;
            hold-trigger-on-release;
        };
    };

    /* L1 + L2 held together -> Adjust (ZMK conditional layers; this is
     * the "Fn chord" the v1 layout spec called for). */
    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust_cond {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        label = "Hojicha44";

        default_layer {
            bindings = <
                &kp Q &kp W &kp E &kp R &kp T &kp GRAVE &kp P &kp O &kp I &kp U &kp Y &kp BSLH
                &hml LCTRL A &hml LALT S &hml LGUI D &hml LSHIFT F &kp G &kp LBKT &hmr RCTRL SCLN &hmr RALT L &hmr RGUI K &hmr RSHIFT J &kp H &kp RBKT
                &kp Z &kp X &kp C &kp V &kp B &kp MINUS &kp SLASH &kp DOT &kp COMMA &kp M &kp N &kp SQT
                &kp ESC &mo 1 &kp TAB &kp SPACE &none &none
                &kp DEL &mo 2 &kp BSPC &kp RET
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
        lower_layer {
            bindings = <
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS &kp EQUAL
                &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT &kp CARET &kp AMPS &kp ASTRK &kp LPAR &kp RPAR &kp UNDERSCORE &kp PLUS
                &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
                &trans &trans &trans &trans &none &none
                &trans &trans &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp C_AC_SCROLL_UP C_AC_SCROLL_DOWN>;
        };
        raise_layer {
            bindings = <
                &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &kp PSCRN &kp INS &kp CLCK &kp HOME &kp END &none
                &kp C_MUTE &kp C_PREV &kp C_PLAY &kp C_NEXT &kp C_VOL_UP &kp C_VOL_DN &kp PG_UP &none &kp UP &none &none &none
                &kp K_UNDO &kp K_CUT &kp K_COPY &kp K_PASTE &none &none &kp PG_DN &kp LEFT &kp DOWN &kp RIGHT &kp DEL &kp BSPC
                &trans &trans &trans &trans &none &none
                &trans &trans &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp C_PREV C_NEXT>;
        };
        adjust_layer {
            bindings = <
                &none &bootloader &sys_reset &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none
                &none &none &none &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };

    /* Encoder push -> Mute on BOTH halves (the dtsi defines the direct-GPIO
     * kscan on the shared D16; the sideband keeps the 46-cell matrix
     * untouched). First article: press on EACH half must send Mute. */
    enc_push_sideband: sideband_enc_push {
        compatible = "zmk,kscan-sideband-behaviors";
        kscan = <&enc_push_kscan>;
        auto-enable;
        push_mute: push_0 {
            row = <0>;
            column = <0>;
            bindings = <&kp C_MUTE>;
        };
    };
};
