/*
 * Hojicha44 minimal keymap — DRAFT. 46 transform positions over the combined
 * 4x12 span (rows 0-2: RC(r,0)..RC(r,11); row 3: RC(3,0)..RC(3,9);
 * RC(3,10..11) unpopulated and omitted from the map, Corne-style).
 * Bindings are in the transform's POSITION order: RC-listed ROW-MAJOR with
 * both halves per row — position 0-5 = left row0 C0-5, 6-11 = right row0,
 * 12-17 = left row1, ... so each layer lists L0 L1 L2 | R0 R1 R2 row by
 * row. Left hand: 22 keys + 2 &none for unpopulated R3C4-C5 (floating row
 * reads low through the pull-down).
 * Mirror per spec/layout.yaml (the export_kle mirror maps Ctrl->Shift,
 * Cmd->Opt): right thumbs Shift/Opt/L2/Enter, right inner column
 * backslash/brace/Esc. L2 (raise) is a transparent placeholder until the
 * open_points decisions land — this file proves the scan/spatial mapping
 * only, and tests/spec_checks.cjs derives its signature FROM the spec.
 * Combos (Fn chord = L1+L2, Tab via L1+Space) are still open decisions.
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";
        label = "Hojicha44";

        default_layer {
            bindings = <
                &kp Q &kp W &kp E &kp R &kp T &kp GRAVE
                &kp P &kp O &kp I &kp U &kp Y &kp BSLH
                &kp A &kp S &kp D &kp F &kp G &kp LBKT
                &kp SCLN &kp L &kp K &kp J &kp H &kp RBKT
                &kp Z &kp X &kp C &kp V &kp B &kp TAB
                &kp SLASH &kp DOT &kp COMMA &kp M &kp N &kp ESC
                &kp LCTRL &kp LGUI &mo 1 &kp SPACE &none &none
                &kp RSFT &kp RALT &mo 2 &kp ENTER
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
        lower_layer {
            bindings = <
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &none &none
                &trans &trans &trans &trans
            >;
            /* Draft: encoder scroll on the lower layer (v3.2 open decision:
             * volume stays on the default layer). C_AC_SCROLL_UP/DOWN are
             * this tree's consumer-page names (v0.3 has no bare C_SCROLL_*);
             * if hosts ignore them, switch to &im wheel_* after adding
             * CONFIG_ZMK_POINTING. */
            sensor-bindings = <&inc_dec_kp C_AC_SCROLL_UP C_AC_SCROLL_DOWN>;
        };

        /* L2 (raise) placeholder — right thumb mo 2 targets this layer
         * (index 2, spec/layout.yaml thumbs "L2"). Contents are the
         * open_points decision (Fn chord = L1+L2 provisional); ships
         * all-transparent so the FP gate can verify reachability without
         * inventing L2 keys. Row sensors mirror the base volume pair —
         * NOT &trans: the pinned ZMK v0.3 build rejects transparent in
         * sensor-bindings ("/behaviors/transparent lacks
         * #sensor-binding-cells"), and a layer with no sensor-bindings
         * would eat sensor events while L2 is held. Caveat pending the
         * layer decision: during the L1+L2 chord, rotation reads volume
         * rather than L1's scroll.
         */
        raise_layer {
            bindings = <
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &none &none
                &trans &trans &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };

    /* ASSUMED pending first-article: EC11 push -> C_MUTE. Mute joins the
     * existing C_VOL_UP/C_VOL_DN media cluster from sensor-bindings.
     * Sideband keeps the 46-cell matrix bindings/transform untouched: the
     * direct kscan in hojicha44.dtsi emits row 0 / column 0 for the single
     * push key. Binding source: zmk.dev/docs/config/kscan (sideband
     * section) + app/dts/bindings/kscan/zmk,kscan-sideband-behaviors.yaml
     * in zmkfirmware/zmk. First-article: press on EACH half must send Mute
     * (both halves define the push on D16). */
    enc_push_sideband: sideband_enc_push {
        compatible = "zmk,kscan-sideband-behaviors";
        kscan = <&enc_push_kscan>;
        auto-enable;
        push_mute: push_0 {
            row = <0>;
            column = <0>;
            bindings = <&kp C_MUTE>;
        };
    };
};
