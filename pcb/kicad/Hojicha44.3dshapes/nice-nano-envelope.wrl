#VRML V2.0 utf8
# nice!nano ENVELOPE PLACEHOLDER (bounding box only, not a detailed model).
# Real dims 34.1 x 18.3 x 3.2 mm; KiCad reads VRML in 0.1-inch units
# (1 unit = 2.54 mm — calibrated by render 2026-10-14), hence /2.54 below.
# KiCad maps VRML +y to footprint-local -y (proven by two-cube render),
# so footprint-local (lx,ly) is written here as VRML (lx,-ly).
# Floats 4.5 mm over the board on the socket stack. USB nub toward
# footprint pad-1 end. Proves keepout and stack envelope only.
Transform {
  translation -3.0 -5.5 2.402
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0.10 0.10 0.16 } }
      geometry Box { size 7.205 13.425 1.260 }
    }
    Transform {
      translation 0 7.874 0
      children [ Shape {
        appearance Appearance { material Material { diffuseColor 0.65 0.65 0.70 } }
        geometry Box { size 3.504 2.756 1.260 } } ]
    }
  ]
}
