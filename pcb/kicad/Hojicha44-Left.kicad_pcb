(footprint "Hojicha44:Socket_Strips_2x12_P2.54mm_NiceNano"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(uuid "d9426ca5-4ec0-4393-afc5-b0b4536d1727")
	(at 110.38 45.47 180)
	(descr "2x12 pin socket strip for the nice!nano v2 module, 2.54mm pitch, 15.24mm row separation, Pro Micro numbering: pads 1-12 run down the TX/D1 edge (x=0) and pads 13-24 down the RAW edge (x=-15.24) in the OPPOSITE direction, so pads 1 (D1) and 24 (RAW) are both at the USB end (y=0), while pads 12 (D9) and 13 (D10) are at the antenna end (y=27.94). Do NOT substitute the stock PinSocket_2x12 (row-major serpentine, 2.54mm row spacing): it silently scrambles every MCU net and cannot fit the 15.24mm module. Placement: pin-1/USB end toward the module USB end (open board edge).")
	(tags "socket strips 2x12 P2.54mm nice!nano nice_nano Pro Micro column-major")
